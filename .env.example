# Copiar a .env (cp .env.example .env) y completar. .env nunca se versiona.

# Application
APP_ENV=development
APP_PORT=8003
LOG_LEVEL=INFO
TZ=America/Mexico_City
# Local: data/sales_bot.db (relativo a la raíz del proyecto). En Docker: /app/data/sales_bot.db
DATABASE_PATH=data/sales_bot.db

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=

# Meta WhatsApp
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v25.0

# Sales (formato internacional, ej. +52 55 1234 5678)
SALES_PHONE=
# Nombre de la plantilla aprobada en Meta para avisar al vendedor (no el texto del mensaje)
SALES_NOTIFICATION_TEMPLATE=

# Worker
WORKER_ENABLED=true
WORKER_POLL_INTERVAL=1
WORKER_MAX_ATTEMPTS=5
